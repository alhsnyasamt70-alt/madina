server {
    listen ${PORT};
    server_name localhost;
    root /usr/share/nginx/html;

    # Include default mime types
    include /etc/nginx/mime.types;

    # Explicitly declare font mime types in case they are missing in the base image
    types {
        font/woff2 woff2;
        font/woff woff;
        font/ttf ttf;
        font/otf otf;
        application/vnd.ms-fontobject eot;
    }

    # Main routing
    location / {
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Static assets handling (CSS, JS, Images, Fonts)
    # Ensure they return 404 if not found, instead of falling back to index.html
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|otf)$ {
        add_header Access-Control-Allow-Origin *;
        expires 30d;
        access_log off;
        log_not_found off;
        try_files $uri =404;
    }

    # Custom error pages if needed
    error_page 404 /index.html;
}
